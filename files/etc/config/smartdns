# SmartDNS UCI 配置（由 uci-defaults 进一步修正，此处为基线）
config smartdns
    option enabled '1'
    option port '53'
    option bind_addr '0.0.0.0'
    option bind_addr '::'
    option tcp_server '1'
    option predecrease_dns_ttl '0'
    option cache_size '32768'
    option cache_persist '1'
    option cache_file '/tmp/smartdns.cache'
    option prefetch_domain '1'
    option serve_expired '1'
    option serve_expired_ttl '86400'
    option dualstack_ip_selection '1'
    option redirect 'none'
    option no_rule_addr '0'
    option no_rule_nameserver '0'
    option no_rule_ipset '0'
    option no_rule_soa '0'
    option no_idn '1'
    option enable_dns64 '0'
    option force_a_soa '0'
    option force_aaaa_soa '0'
    option auto_restart '1'
    option smartdns_path '/usr/sbin/smartdns'
    option config_file '/etc/smartdns/smartdns.conf'
    option log_level 'warn'
    option log_size '128KB'
    option log_file '/tmp/smartdns.log'
    option coredump '0'
