#
# 兆能 M2 主路由基础配置 (General-M2.config)
#
# 与 ZN-M2.config 合并后作为完整 .config。
# 设计原则：
#   - 路由器基础网络功能齐全（IPv4/IPv6 双栈、DHCP、DNS、防火墙、UPnP、PPPoE 等）
#   - 默认中文（简体），Aurora 主题，带 WebUI 的插件全部带中文 i18n
#   - 带 ttyd 终端，集成常用配置/诊断工具
#   - 25.12 系列使用 apk 包管理（LuCI → System → Software）
#   - 每项非必需功能默认关闭；不引入科学上网、广告过滤、下载器等重组件
#

# ===== 构建与调试 =====
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ===== 语言与 WebUI =====
CONFIG_LUCI_LANG_zh_Hans=y
# 繁体保留为可选，按需开启；默认简体
# CONFIG_LUCI_LANG_zh_Hant is not set

# LuCI 核心（默认设置 + 简体中文）
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 主题：Aurora（唯一启用，Argon 不编译）
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# ===== 系统基础与诊断工具 =====
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# 终端 & 编辑
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_nano-full=y

# 系统监控（性能与稳定性观测）
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_zoneinfo-asia=y

# 磁盘/分区工具：本机无 USB、无外接硬盘，仅保留基础分区查看能力
CONFIG_PACKAGE_fdisk=y
# 以下为冗余/交互式工具，本场景不装
# CONFIG_PACKAGE_cfdisk is not set
# CONFIG_PACKAGE_sgdisk is not set
# CONFIG_PACKAGE_tune2fs is not set
# CONFIG_PACKAGE_fstrim is not set
# CONFIG_PACKAGE_hdparm is not set
# CONFIG_PACKAGE_smartmontools-drivedb is not set

# 性能测试与基准（轻量，便于验证 NSS 加速是否生效）
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y

# ===== 网络诊断工具箱（集成到 ttyd 使用）=====
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tracepath=y
CONFIG_PACKAGE_traceroute6=y
CONFIG_PACKAGE_driftnet=n

# 额外常用工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ncat=y
CONFIG_PACKAGE_netcat=y
CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_bird2-cli=n

# ===== 路由器基础网络功能 =====
# DHCP / DNS
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# 防火墙（nftables，NSS 加速友好）
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# IPv6 支持
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y

# PPPoE（有线宽带接入）
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=n

# 网桥 / VLAN / Bonding
CONFIG_PACKAGE_bridge=y
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-8021q=y

# UPnP（家庭内网常用，带 WebUI）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

# Wake-on-LAN（带 WebUI）
CONFIG_PACKAGE_luci-app-wol=y

# 定时重启 / 看门狗（保障高负载长期稳定）
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y

# CPU 调频（默认 schedutil，性能与功耗平衡）
CONFIG_PACKAGE_luci-app-cpufreq=y

# ===== 本次需求核心组件 =====
# TTYD 终端（带 WebUI，集成上述网络诊断工具）
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

# KMS 激活服务（带 WebUI）
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y

# DDNS（带 WebUI；含 Cloudflare 脚本用于无 IPv4 公网环境的动态域名）
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_curl=y

# WireGuard（带 WebUI；LuCI 协议支持 + 内核模块）
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# SmartDNS（带 WebUI，改善域名解析体验）
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ===== 计划外功能：全部关闭 =====
# 科学上网全家桶
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-vssr is not set
# CONFIG_PACKAGE_luci-app-bypass is not set
# CONFIG_PACKAGE_luci-app-shadowvpn is not set
# CONFIG_PACKAGE_luci-app-nikki is not set

# 下载器 / 网盘 / 媒体
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-nginx is not set
# CONFIG_PACKAGE_nginx-full is not set
# CONFIG_PACKAGE_luci-app-openlist is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set
# CONFIG_PACKAGE_luci-app-lucky is not set

# 内网穿透 / 远程访问
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_frpc is not set
# CONFIG_PACKAGE_frps is not set

# 广告过滤 / 去广告
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_luci-app-unblockmusic is not set

# USB 打印机 / 共享 / 文件服务器
# CONFIG_PACKAGE_luci-app-usb-printer is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba4-libs is not set
# CONFIG_PACKAGE_ksmbd-server is not set

# 磁盘管理（无外接存储场景）
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set

# 应用过滤 / 家长控制 / 访问控制
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-appfilter is not set
# CONFIG_PACKAGE_luci-app-accesscontrol is not set
# CONFIG_PACKAGE_luci-app-timecontrol is not set
# CONFIG_PACKAGE_luci-app-wifischedule is not set

# 证书 / ACME（无公网 IPv4，80 验证受限，默认关闭）
# CONFIG_PACKAGE_luci-app-acme is not set
# CONFIG_PACKAGE_acme-acmesh-dnsapi is not set

# NSS 软 QoS / SQM（走软桥队列，非硬件卸载，本场景不启用）
# CONFIG_PACKAGE_luci-app-sqm is not set
CONFIG_PACKAGE_sqm-scripts-nss=n

# 3CAT / Athena LED（其他机型专属，本机不装）
# CONFIG_PACKAGE_luci-app-3cat is not set
# CONFIG_PACKAGE_luci-app-athena-led is not set

# uHTTPd 单独 app 与 ttyd 功能重复
# CONFIG_PACKAGE_luci-app-uhttpd is not set

# BanIP（默认关闭，按需启用）
# CONFIG_PACKAGE_luci-app-banip is not set

# 微信推送（依赖消息通道，默认关闭）
# CONFIG_PACKAGE_luci-app-wechatpush is not set

# ARP 绑定（非必需）
# CONFIG_PACKAGE_luci-app-arpbind is not set

# Netdata / 重载监控（资源占用大，默认关闭）
# CONFIG_PACKAGE_luci-app-statistics is not set

# feeds 精简
# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
