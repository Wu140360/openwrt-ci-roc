### 兆能M2 (zn_m2) 主设备配置 ###
### 硬件: IPQ6000 (4x A53 1.2GHz + NPU 1.5GHz), 1GB DDR3 (硬改), 128MB SPI-NAND
### 目标: 家庭主路由, 无WiFi, 无USB, 满血NSS, 性能优先, 精简稳定

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y

### ===== 单设备模式: 仅编译 zn_m2 =====
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

### ===== NSS 满血配置 (不缩减 q6_region, 保持默认) =====
### 注意: 满血NSS指的是NSS核心功能(offload/加速), 与WiFi NSS offload无关
### q6_region 内存区域保持DTSI默认, 不做任何缩减
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

### ===== 完全禁用 WiFi (无WiFi固件/驱动/配置) =====
# CONFIG_PACKAGE_ath11k is not set
# CONFIG_PACKAGE_ath11k-firmware is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-firmware-qca6018 is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-basic is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_luci-app-wireless is not set

### ===== 完全禁用 USB (无USB接口) =====
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-ehci is not set
# CONFIG_PACKAGE_kmod-usb-xhci is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-serial is not set
# CONFIG_PACKAGE_kmod-usb-acm is not set
# CONFIG_PACKAGE_libusb-1.0 is not set
# CONFIG_PACKAGE_usbutils is not set

### ===== 禁用其他不需要的功能 =====
# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

### ===== 禁用 Athena LED (仅京东云设备需要) =====
# CONFIG_PACKAGE_luci-app-athena-led is not set
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn is not set
