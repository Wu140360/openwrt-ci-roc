### ============================================================
###  兆能 M2 (zn_m2 / IPQ6018) 设备层配置
###  - 家庭主路由：完全不带 WiFi、不带 USB
###  - 满血 NSS（保留默认 q6_region / reserved-memory，不缩减）
###  - 硬改 1GiB 内存：保持 DTS 默认布局，仅校验 memory 节点
###  - 硬件 QoS：NSS qdisc 卸载（默认关闭，按需启用；不用 SQM / qosify / nft-qos）
### ============================================================

### --- 1. 目标平台：Qualcomm AX / IPQ60XX ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# 单设备镜像，仅编译兆能 M2，剔除仓库内其他设备的冗余镜像
CONFIG_TARGET_MULTI_PROFILE=n
# 主选择：LibWrt 25.12-nss 中的 zn_m2 profile（兆能 M2 官方命名）
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
# 【兜底，默认关闭】兆能 M2 与 CMCC AX18 (cmiot_ax18) 硬件同源，若所用 LibWrt 源码树
# 未提供 zn_m2 而仅有 cmiot_ax18，把上一行注释掉、启用本行即可（二者互斥，只能选一个）。
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

### --- 2. NSS 满血核心（保留全部，绝不缩减 q6_region / reserved-memory）---
###     有线数据面（路由/桥/VLAN/PPPoE/NAT）走 NSS；WiFi 卸载模块单独关闭，互不影响。
###     说明：LibWrt 25.12-nss 中 NSS 相关 kmod 的确切包名以 `make menuconfig` 为准；
###     下方符号若当前源码树不存在会自动忽略（不会造成编译失败），存在则被选中。
###     核心（确定存在）：drv、ecm
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
###     有线客户端（按需求选取；不存在则忽略）：PPPoE / IPv6 / VLAN / Bridge / IGS / MATCH
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-ipv6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-virt-if=y
###     以下为历史/可选命名，若 LibWrt 未提供会自动忽略：
CONFIG_PACKAGE_kmod-qca-nss-drv-ipq60xx=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-netfilter=y

### --- 3. 明确关闭软 QoS / 冲突框架（保持 NSS 数据面纯净，禁止与硬件路径叠加）---
###     详见第 9 节。sqm-scripts-nss 本质仍是 SQM frontend + NSS backend，不符合"纯硬件 QoS"，剔除。
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_sqm-scripts-nss is not set
# CONFIG_PACKAGE_qos-scripts is not set
# CONFIG_PACKAGE_qosify is not set
# CONFIG_PACKAGE_luci-app-qos is not set
# CONFIG_PACKAGE_nft-qos is not set

### --- 4. 完全不带 WiFi：关闭无线驱动 / 固件 / 用户态 / LuCI ---
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set
# CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt is not set
# CONFIG_PACKAGE_ipq-wifi-cmiot_ax18 is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_luci-app-wireless is not set
###     NSS WiFi offload 插件一并关闭（保留 NSS 核心本身）
# CONFIG_PACKAGE_kmod-qca-nss-wifi is not set
# CONFIG_PACKAGE_nss-wifi-offload is not set

### --- 5. 无 USB / 无块存储：关闭 USB 与文件系统相关（无外接盘，节省空间）---
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-serial-option is not set
# CONFIG_PACKAGE_kmod-usb-serial-cp210x is not set
# CONFIG_PACKAGE_kmod-usb-serial-pl2303 is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_blockd is not set
# CONFIG_PACKAGE_blkid is not set
# CONFIG_PACKAGE_lsblk is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_cfdisk is not set
# CONFIG_PACKAGE_sgdisk is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-ntfs is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-scsi-core is not set
# CONFIG_PACKAGE_kmod-scsi-generic is not set
# CONFIG_PACKAGE_luci-app-usb-printer is not set

### --- 6. 1GiB 内存策略：保持 DTS 默认布局，不缩减 q6/NSS 保留内存 ---
###     【默认关闭 zram】1GiB + 纯有线场景下内存通常充裕，zram 会带来额外 CPU 与
###     压缩抖动，对"高负载持续工作"反而不利。若后续出现内存压力，再手动启用下方五行即可，
###     无需改动 DTS / q6_region。
# CONFIG_PACKAGE_zram-swap is not set
# CONFIG_PACKAGE_kmod-lib-lz4 is not set
# CONFIG_KERNEL_ZRAM_BACKEND_LZ4 is not set
# CONFIG_KERNEL_ZRAM_BACKEND_LZO is not set
# CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4 is not set

### --- 7. NSS 固件 / 内存 profile（跟随 LibWrt 默认，不擅自调整大小）---
###     【重要】完全不带 WiFi，故 ath11k 相关的 MEM_PROFILE / NSS_MESH 必须关闭，
###     它们属于 ath11k 无线驱动，与有线 NSS（drv/ecm/pppoe/ipv6）毫无关系，开着反而
###     会引入无线依赖、违背"完全不带 WiFi"。NSS/SoC 的保留内存由 q6_region /
###     reserved-memory 决定，本配置一律不动（保持 DTS 默认）。
# CONFIG_ATH11K_MEM_PROFILE_512M is not set
# CONFIG_ATH11K_MEM_PROFILE_1024M is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_ATH11K_NSS_SUPPORT is not set
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

### --- 8. LED / 指示灯（兆能 M2 无显示屏，保留基础 LED 即可）---
CONFIG_PACKAGE_luci-app-leds=y

### --- 9. 硬件 QoS：【默认关闭，按需启用】---
###     策略（多方核对后结论，见 README "NSS QoS 卸载机制"）：
###     a) 数据面(NAT/路由/桥/VLAN/PPPoE)由 kmod-qca-nss-drv + ECM 硬件卸载 —— 始终启用（第2节），这是"满血 NSS"核心；
###     b) QoS 调度(qdisc/HTB/分类)走 tc，init.d/nss-qos 运行时会检测 nss_qdisc 模块：存在则卸载到 NSS，否则退化为软件 HTB。
###     由于 IPQ60XX + 6.12 内核的 nss_qdisc 缺少充分实测证据，为避免影响稳定性，默认【不加载 qdisc 模块】，
###     仅保留 tc / kmod-sched 工具链；需要 QoS 时在 LuCI 或 `uci set nss-qos.@nss-qos[0].enabled=1` 开启。
# CONFIG_PACKAGE_kmod-qca-nss-qdisc is not set
# CONFIG_PACKAGE_qca-nss-qdisc is not set
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-act-skbmod=y
CONFIG_PACKAGE_kmod-sched-act-skbedit=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_iproute2=y
