#
# 兆能 M2 (ZN-M2) —— Qualcomm IPQ6000 / qualcommax_ipq60xx
# 定位：无 WiFi + USB3.0 + 满血 NSS（仅有线）+ 极简稳定 + Aurora 简体中文
#
# 合并顺序：cat configs/ZN-M2.config configs/General.config > .config
#           => 同一符号以 General.config 为准，故本文件与 General.config 无重复键。
# 语法：仅使用 =y / =m / =n
#

### ===== 1. 目标平台：只保留 zn_m2 一台设备 =====

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 设备专属包取反：本机无 WiFi（原 profile 自带 ipq-wifi-zn_m2），
# 并从 qualcommax / ipq60xx 的 DEFAULT_PACKAGES 中剔除 ath11k 全家桶与 wpad。
# 该写法与源码树内 jdcloud_re-cs-07（官方无 WiFi 变体）完全一致。
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2="-ipq-wifi-zn_m2 -ath11k-firmware-ipq6018 -ath11k-firmware-qcn9074 -kmod-ath11k -kmod-ath11k-ahb -kmod-ath11k-pci -kmod-qca-nss-drv-wifi-meshmgr -wpad-openssl -hostapd-common"

### ===== 2. NSS 平台参数：512MB / 固件 11.4 / q6_region 保持默认不缩减 =====

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

### ===== 3. NSS 驱动编译开关：开有线卸载，关全部无线卸载 =====

CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_LAG_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_MATCH_ENABLE=y
CONFIG_NSS_DRV_MIRROR_ENABLE=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=n
CONFIG_NSS_DRV_WIFI_MESH_ENABLE=n
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=n
CONFIG_NSS_DRV_WIFI_LEGACY_ENABLE=n

### ===== 4. 完全不带 WiFi（内核模块 / 固件 / 用户态 / 无线专用 app 全部 =n）=====

CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-board-ipq6018=n
CONFIG_PACKAGE_ipq-wifi-zn_m2=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-mbedtls=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-openssl-sae=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_hostapd-basic=n
CONFIG_PACKAGE_wpa-supplicant-mbedtls=n
CONFIG_PACKAGE_wpa-supplicant-openssl=n
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iw-full=n
CONFIG_PACKAGE_iwinfo=n
CONFIG_PACKAGE_wireless-tools=n
CONFIG_PACKAGE_luci-app-wifischedule=n

### ===== 5. USB3.0 硬件与存储（本机已硬改 USB3.0，dwc3 控制器）=====

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-filemanager=y
