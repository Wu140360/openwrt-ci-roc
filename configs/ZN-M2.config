# ============================================================
#  兆能 ZN-M2 (IPQ6000 / qualcommax ipq60xx) 专用编译配置
#  ----------------------------------------------------------------
#  硬件前提：
#    - 已硬改 1GB RAM（CDT 已更新，系统可识别约 907MB）
#    - 无 USB 接口，无外接存储
#    - 已刷入第三方 U-Boot
#    - 仅作家庭主路由使用（纯有线，完全不带 WiFi）
#  软件策略：
#    - 开启满血 NSS（q6_region 保持源码默认 85MB，绝不缩减）
#    - 完全不带 WiFi（不含 ath11k / wpad / 任何无线包）
#    - 完全不带 USB（不含 kmod-usb-*）
#    - NSS QoS：sqm-scripts-nss（nss-qdisc + cake）+ luci-app-sqm
#    - WebUI：LuCI + aurora 主题（唯一，不重复）
#    - 包管理：OpenWrt 25.12 使用 apk
#    - 语言：简体中文（含插件 i18n）
#    - 主机名：openwrt
# ============================================================

### 目标平台（单设备：仅兆能 ZN-M2）###

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

### 满血 NSS（保持 q6_region 默认，不缩减）###

CONFIG_NSS_FIRMWARE_VERSION_11_4=y

### ============================================================
###  LuCI 核心与 WebUI
### ============================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y

### 语言：简体中文为主（含插件 i18n）###

CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y

### 主题：仅 aurora（唯一，不重复）###

CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

### ============================================================
###  NSS 加速 & 网络性能
### ============================================================

CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_turboacc=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_kmod-shortcut-fe-cm=y
CONFIG_PACKAGE_kmod-nss-ifb=y

### NSS QoS：sqm-scripts-nss（nss-qdisc + cake），满血 NSS 下的标准 QoS 方案 ###

CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-sched-nss=y

### ============================================================
###  路由器基础网络功能（齐全）
### ============================================================

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-status=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-bonding=y
CONFIG_PACKAGE_luci-app-leds=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-lldp=y
CONFIG_PACKAGE_luci-app-igmp-proxy=y

### IPv6 全套 ###

CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-app-odhcpd_ipv6only=y

### UPnP / NAT-PMP（家用主路由常用）###

CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y

### DDNS（家用动态公网/DDNS-GO 场景）###

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y

### WireGuard ###

CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

### SmartDNS（解决 GitHub DNS 污染 + 国内域名加速，内置默认设置）###

CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y

### KMS（vlmcsd）###

CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y

### 网络工具与诊断 ###

CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-diag-core=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-ipset=y
CONFIG_PACKAGE_iptables-nftables=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_iproute2=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bind-host=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_traceroute6=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_nping=y
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_netperf=y

### ============================================================
###  TTYD 终端（集成常用配置/调试工具）
### ============================================================

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_findutils=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_less=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_patch=y
CONFIG_PACKAGE_which=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_openssh-sftp-server=y

### 进程 / 性能 观测（轻量）###

CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y

### ============================================================
###  系统维护 / 稳定性 / 散热优化
### ============================================================

CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-openssl=y

### ZRAM 交换（1G 内存充足但仍启用轻量 ZRAM，高负载更稳定）###

CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 基准 / 设备信息 ###

CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y

### ============================================================
###  DNS / 域名解析（SmartDNS 为主，dnsmasq 基础保留）
### ============================================================

CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dnsmasq-full=y

### ============================================================
###  显式剔除（防止被依赖或其他 config 重新拉入）
### ============================================================

