### ZN M2 (IPQ6000, 512MB RAM, USB3.0, expanded u-boot layout) ###
### Only the zn_m2 profile is built. No WiFi. ###

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2=""

# Kept for the 512MB board profile. It is inert while kmod-ath11k is disabled.
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# No wireless stack at all: no driver, firmware, board data, hostapd or wpad.
CONFIG_PACKAGE_ipq-wifi-zn_m2=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_hostapd-utils=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mbedtls=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-wolfssl=n
