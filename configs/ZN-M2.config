#
# Target: ZN-M2 (兆能 M2 / ZN-M2)
# SoC    : Qualcomm IPQ6000 (qcom,ipq6018)
# 定位    : 家庭主路由 / 满血 NSS / 无 WiFi / 无 USB / 高负载稳定优先
# 说明    :
#   1) 本配置仅保留 ZN-M2 一个设备 profile，剔除仓库内其他机型，
#      避免生成无关设备的镜像与设备专属包。
#   2) WiFi 部分（wifi 固件、wpad、hostapd、无线脚本、iwinfo 类依赖）
#      全部不编译、不打包；ath11k 驱动内核模块虽在镜像中，但本设备
#      DEVICE_PACKAGES 未装入任何无线包，故无线不可用。
#   3) USB 相关内核模块与用户态工具全部关闭，适配本机无 USB 接口的硬件。
#   4) q6_region 内存区域保持上游默认（不缩减），满血 NSS 所需内存
#      预留完整保留。
#   5) 默认中文（简体）、Aurora 主题、ttyd 终端、apk 包管理、
#      KMS(vlmcsd)、DDNS、WireGuard、SmartDNS。不含任何科学上网组件。
#

# ===== Target & 单设备 profile =====
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 本机专属设备包：仅 LED/电源管理等无外设依赖项；不含任何无线包
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2=""

# ===== NSS 平台与固件 =====
# 512M 内存配置档；满血 NSS 所需 q6_region 内存区域保持上游默认，不做缩减
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ===== 精简原则：关闭 WiFi / USB / 多媒体 / 打印 =====
# 无线全家桶
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_hostapd-basic is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_wireless-tools is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-qrtr is not set
# CONFIG_PACKAGE_kmod-qrtr-tun is not set
# CONFIG_PACKAGE_kmod-rmnet is not set
# CONFIG_PACKAGE_kmod-rmnet-ipa is not set
# CONFIG_PACKAGE_ath11k-firmware is not set
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ath11k-board-ipq6018 is not set

# USB 全家桶（本机无 USB 接口）
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb-ehci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc2 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-acm is not set
# CONFIG_PACKAGE_kmod-usb-serial is not set
# CONFIG_PACKAGE_kmod-usb-serial-ch341 is not set
# CONFIG_PACKAGE_kmod-usb-serial-cp210x is not set
# CONFIG_PACKAGE_kmod-usb-serial-ftdi is not set
# CONFIG_PACKAGE_kmod-usb-serial-pl2303 is not set
# CONFIG_PACKAGE_kmod-usb-net is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ether is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-ncm is not set
# CONFIG_PACKAGE_kmod-usb-net-rndis is not set
# CONFIG_PACKAGE_kmod-usb-net-ipheth is not set
# CONFIG_PACKAGE_kmod-usb-net-asix is not set
# CONFIG_PACKAGE_kmod-usb-net-asix-ax88179 is not set
# CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan is not set
# CONFIG_PACKAGE_kmod-usb-net-sierrawireless is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152 is not set
# CONFIG_PACKAGE_kusb is not set
# CONFIG_PACKAGE_usbutils is not set

# 非必需功能默认关闭
CONFIG_PACKAGE_sqm-scripts-nss=n
# CONFIG_PACKAGE_luci-app-sqm is not set
