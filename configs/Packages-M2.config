#
# ZN-M2 软件包编译配置项 (Packages-M2.config)
#
# 仅包含本机实际需要的软件包与 LuCI 语言包，与 ZN-M2.config + General-M2.config
# 合并后构成完整编译配置。脚本 scripts/Roc-script.sh 与 scripts/SDK-script.sh
# 会读取本文件中带 =y 的符号，决定是否拉取并覆盖上游对应软件包源码。
#
# 命名说明：OpenWrt 25.12 起包管理器为 apk，但 CONFIG_PACKAGE_ 符号命名
# 与 opkg 时代保持一致；符号必须以 `make menuconfig` 实际可见名为准。
# 编译前请在本文件所在目录执行 `grep -rn` 或对照 menuconfig 核实，
# 尤其标注 [需核实] 的项。
#

# ===== LuCI 语言 =====
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set

# ===== 主题与配置器（Aurora 唯一）=====
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set

# ===== 核心需求插件 =====
# TTYD 终端
CONFIG_PACKAGE_luci-app-ttyd=y

# KMS (vlmcsd)
CONFIG_PACKAGE_luci-app-vlmcsd=y

# DDNS（含 Cloudflare 脚本，用于无 IPv4 公网环境的动态域名）
CONFIG_PACKAGE_luci-app-ddns=y
# [需核实] 25.12 中该符号可能为 ddns-scripts-cloudflared 或已并入 ddns-scripts
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# WireGuard（LuCI 协议支持 + 应用界面）
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# SmartDNS
CONFIG_PACKAGE_luci-app-smartdns=y
# [需核实] 25.12 中 i18n 包命名可能为 luci-i18n-smartdns-zh-cn（与 base 风格一致）
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

# ===== 基础网络（带 WebUI，精简重复项）=====
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y

# ===== 计划外功能：全部关闭 =====
# 科学上网
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-vssr is not set

# 下载器 / 网盘 / Web 服务器
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set
# CONFIG_PACKAGE_nginx-full is not set

# 其他机型专属 / 非必需
# CONFIG_PACKAGE_luci-app-gecoosac is not set
# CONFIG_PACKAGE_luci-app-3cat is not set
# CONFIG_PACKAGE_luci-app-athena-led is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set
# CONFIG_PACKAGE_luci-app-acme is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-uhttpd is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-usb-printer is not set
# CONFIG_PACKAGE_luci-app-wechatpush is not set
