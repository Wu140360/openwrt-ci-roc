### 兆能M2 (zn_m2) 专用配置 - IPQ60XX 满血NSS / 无WiFi / 无USB / 精简高性能 ###
### 硬件: 高通IPQ6000 (4x A53 1.2GHz + 1.5G NPU), 硬改1GB RAM, 128MB NAND, 无USB, 4网口(1WAN+3LAN)
### 用途: 家庭主路由 (无WiFi, 纯有线路由)

# ============ 目标平台 (必须) ============
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 关闭多profile, 只编译zn_m2单设备, 减小体积
# CONFIG_TARGET_MULTI_PROFILE is not set

# ============ NSS 满血配置 (不缩减q6_region, 保持默认) ============
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
# 注意: 虽然不用WiFi, 但NSS驱动依赖ath11k相关符号, MEM_PROFILE需保持
# q6_region 内存预留保持源码默认 (ipq6018.dtsi 默认预留, 不修改)

# ============ 完全禁用WiFi相关 (无WiFi) ============
# 不编译任何WiFi驱动和无线工具, 彻底移除无线功能以降低内存占用和发热
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath10k=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_kmod-lib80211=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mini=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iwinfo=n
CONFIG_PACKAGE_wireless-regdb=n
CONFIG_PACKAGE_wifi-scripts=n
# 不设置CONFIG_PACKAGE_luci-app-wireless (不存在)
# 移除所有WiFi相关包的选中的引用

# ============ 完全禁用USB相关 (无USB接口) ============
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-ehci=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=n
CONFIG_PACKAGE_kmod-usb-net-rndis=n
CONFIG_PACKAGE_kmod-usb-acm=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_kmod-usb-serial-option=n
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=n
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=n
CONFIG_PACKAGE_usbutils=n
# USB打印机等依赖USB的包全部禁用
CONFIG_PACKAGE_luci-app-usb-printer=n

# ============ 禁用不需要的feed ============
# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ============ 精简: 移除不需要的包 (降低体积) ============
# 禁用PPPoE相关 (家庭主路由通常DHCP/静态IP, 如需可启用)
# CONFIG_PACKAGE_ppp=n
# CONFIG_PACKAGE_pppoe-server=n
# 如需PPPoE客户端请取消上面的注释

# 禁用不需要的大型包
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-athena-led=n
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_luci-app-gecoosac=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-appfilter=n

# ============ 性能优化 ============
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# CPU频率调节 (降低发热, 1.2GHz默认即可, 无需超频)
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufreq-info=y

# ============ NSS硬件加速 (满血) ============
# NSS全功能已在LibWrt源码中默认开启, 这里确保关键模块编译
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-rmnet=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlan=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y

# ============ NSS QoS方案: qosify + nss.qdisc ============
# 使用qosify配合NSS硬件qdisc实现高性能QoS, 在NSS加速路径上做流量整形
# 这是目前IPQ60XX上唯一能在NSS加速路径上工作的QoS方案
CONFIG_PACKAGE_qosify=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_luci-app-qosify=y
# 注意: qosify通过nss.qdisc与NSS集成, 无需传统SQM(sqm-scripts)
# 传统SQM (sqm-scripts) 会与NSS加速冲突, 已禁用

# ============ 核心网络功能 ============
# 防火墙
CONFIG_PACKAGE_luci-app-firewall=y
# UPnP (如果需要, 默认开启)
CONFIG_PACKAGE_luci-app-upnp=y
# DDNS
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts=y
# WireGuard
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
# SmartDNS (解决GitHub DNS污染)
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
# KMS (vlmcsd)
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
# ACME (Let's Encrypt)
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
# 自动重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# Watchcat (网络监控)
CONFIG_PACKAGE_luci-app-watchcat=y
# uHTTPd
CONFIG_PACKAGE_luci-app-uhttpd=y
# TTL/WAN口设置
CONFIG_PACKAGE_luci-app-ttl=y
# 网络诊断
CONFIG_PACKAGE_luci-app-diag-core=y

# ============ WebUI主题: Aurora ============
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

# ============ 中文语言支持 (简体+繁体) ============
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-qosify-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# ============ TTYD终端 (集成常用网络配置工具) ============
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
# TTYD内集成常用工具
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_dmesg=y

# ============ 包管理 (25.12默认APK, 确保apk相关包) ============
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ============ 基础系统工具 ============
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_hdparm=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_btop=n
# 无USB/无外接硬盘, 移除硬盘相关工具 (hdparm/smartmontools)
# 保留基础分区工具用于NAND

# ============ 编译选项 ============
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_PER_FEED_REPO=y

# ============ 设备名设置 ============
# hostname在ZNM2-script.sh中设置为openwrt (通过sed修改config_generate)
# 同时通过uci-defaults 99-znm2-defaults 兜底设置

# ============ IPv6支持 (宽带仅有IPv6公网) ============
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6to4=y
CONFIG_PACKAGE_luci-proto-ipip=y
