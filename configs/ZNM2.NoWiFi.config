### 兆能 M2（ZN-M2 / IPQ6000）专用设备配置：只编这一台 + 完全无 WiFi ###
### 硬件：512M 内存 + 硬改 USB3.0 + 暗云 U-Boot；定位：家庭主路由（拨号/NAT/IPv6） ###

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# 保留 MULTI_PROFILE（只有一个 DEVICE，不是空壳）：产物名/清单名与其它机型一致，走 per-device rootfs
CONFIG_TARGET_MULTI_PROFILE=y
# 只保留兆能 M2，其余 DEVICE_* 一律不写
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 512M 内存 profile（q6_region 已由 ipq6018-512m.dtsi 默认预留 55MB，勿改）
CONFIG_ATH11K_MEM_PROFILE_512M=y
# NSS 固件版本保持 11.4（与你现有 IPQ60XX.config 一致）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# 无 WiFi：关闭 NSS WiFi Mesh 卸载能力（该项依赖 ATH11K_NSS_SUPPORT，ath11k 关掉后本行会被 defconfig 丢弃，写 n 表示明确意图）
CONFIG_ATH11K_NSS_MESH_SUPPORT=n

# ================= 完全剔除 WiFi（驱动 + 固件 + 校准 + 用户态） =================
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=n
# 注：ipq-wifi-zn_m2 是 image/ipq60xx.mk 里 zn_m2 的 DEVICE_PACKAGES 默认项，
#     config 的 =n 压不住 DEVICE_PACKAGES，已改由 scripts/Roc-script.sh 在编译前从 mk 中删除（见任务书 5.5）。
#     &wifi 节点同步在 DTS 里置 disabled（同样由 Roc-script.sh 处理）。
