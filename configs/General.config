### ============================================================
###  通用编译配置（兆能 ZN-M2 / OpenWrt 25.12 / apk）
###  ----------------------------------------------------------------
###  说明：本文件与 configs/ZN-M2.config 合并后作为最终 .config
###  原则：只保留 ZN-M2 实际需要的基础/工具项，剔除所有冗余
### ============================================================

### 开发/编译优化 ###

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

### 禁用不需要的 feed（减少依赖污染）###

# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set

### 签名（apk 需要公钥；沿用项目签名密钥）###

CONFIG_SIGNATURE_CHECK=y

### ============================================================
###  LuCI 语言（仅简体中文）
### ============================================================

CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set

### ============================================================
###  各插件对应的简体中文翻译（按需，避免全量拉入）
### ============================================================

CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lldp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-igmp-proxy-zh-cn=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y

### ============================================================
###  SmartDNS 内置默认设置（解决 GitHub DNS 污染）
###  ----------------------------------------------------------------
###  策略：
###    - 国内域名走本地运营商 DNS / 114 / 阿里等，并启用缓存
###    - 国外域名（含 github.com 相关）走可信上游
###      （如 Cloudflare 1.1.1.1、Google 8.8.8.8、DNSPod 等）
###    - 通过域名组 + force-AAAA / no-dualstack 等方式规避 DNS 污染
### ============================================================

CONFIG_SMARTDNS_SETTING=y
CONFIG_SMARTDNS_CONF_PATH="/etc/smartdns/smartdns.conf"

### ============================================================
###  显式禁用（兜底，防止被 feeds 默认选中）
### ============================================================

### 说明：以下“不需要的 LuCI 应用”一律不在此处声明禁用。
### 原因：本文件（General.config）在合并顺序中位于 ZN-M2.config 之后，
###   `=n` / `is not set` 会覆盖前者已启用的 `=y`，导致功能被误关。
### 所有剔除项已在 ZN-M2.config 的“显式剔除”段落统一维护（单一事实源）。
### 此处仅保留真正全局性、且与任何设备配置不冲突的通用开关。

### 科学上网 / 文件/下载/社交 类（一律不加入）###

# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-nginx is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-app-openlist2 is not set
# CONFIG_PACKAGE_luci-app-gecoosac is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-wechatpush is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-banip is not set
# CONFIG_PACKAGE_luci-app-3cat is not set
# CONFIG_PACKAGE_luci-app-uhttpd is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-diskman is not set
# CONFIG_PACKAGE_luci-app-hd-idle is not set
# CONFIG_Package_luci-app-usb-printer is not set
# CONFIG_PACKAGE_luci-app-wifischedule is not set

### 无线 / USB（兜底）###

# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set

### ============================================================
###  apk 包管理（OpenWrt 25.12 默认，编译进固件）
### ============================================================

CONFIG_PACKAGE_apk=y
CONFIG_PACKAGE_apk-metrics=y
CONFIG_PACKAGE_luci-app-opkg=y
# CONFIG_PACKAGE_opkg is not set
