### 通用配置文件（ZN-M2 第二款：PassWall2 版，无 OpenClash）###
### 原则：只保留计划内插件；与 Lucky 小满内置模块重复的独立插件一律剔除 ###

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_zh_Hant is not set

# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

### 要求5：Aurora 主题 + 全简体中文 ###
# luci.mk 依据 CONFIG_LUCI_LANG_zh_Hans=y 自动把所有含 po/zh_Hans 的应用
# 的 luci-i18n-*-zh-cn 包设为默认 y，无需逐一写死包名。
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-compat=y

### 要求4：ttyd 终端 + 能用上的配置 / 调试工具 ###
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y

### 要求6：齐全的基本网络功能 ###
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ipv6=y

### 要求7：指定插件（每一个都带 LuCI 配置页面）###
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

### 本固件不含 OpenClash，故 ruby 及其 YJIT/rust 依赖链整体不安装；
### 仍显式排除 rust，避免 PassWall2 的 shadowsocks-rust 等计划外 Rust 包被误选。
CONFIG_PACKAGE_ruby=n
CONFIG_PACKAGE_rust=n

### 要求7（变体）：PassWall2 编译选项 —— 只保留 Xray 单核心 + nftables 透明代理，
### 关闭与 Xray 功能重复的 sing-box、所有计划外协议插件（含会拉起 rust host 的 shadowsocks-rust）。
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=n

### 要求3 / 要求8：USB 挂载管理 + 日常维护（均有 LuCI 配置页）###
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y

### 要求9：显式排除「与 Lucky 小满重复 / 冗余 / 冲突 / 计划外」插件 ###
# Lucky 小满自带：DDNS、SSL/ACME 证书、计划任务、网络唤醒、Web 服务、端口转发、
# Web 终端、FTP/WebDAV/SMB、FRP、Cloudflare Tunnel、DLNA、Coraza WAF、gRPC 反代。
# 因此下列独立插件全部剔除，避免功能重复与固件体积膨胀：
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts-cloudflare=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_acme-acmesh=n
CONFIG_PACKAGE_acme-acmesh-dnsapi=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_frpc=n
CONFIG_PACKAGE_frps=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_openlist2=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_ariang=n
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_sqm-scripts-nss=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_autocore=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_zram-swap=n
