# ==============================================================================
# 通用配置（configs/General.config）
# 在 configs/IPQ60XX.config 之后追加，后者被本文件覆盖。
# 目标：兆能 M2（IPQ6000 / 硬改 512M RAM + USB3.0）单机型、完全无 WiFi、
#       满血 NSS 有线加速、aurora 主题、全简体中文 LuCI。
# ==============================================================================

CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------------------------- 简体中文 ----------------------------
CONFIG_LUCI_LANG_zh_Hans=y

# ---------------------------- Feeds / 镜像 ----------------------------
# NSS 驱动由 LibWrt 的 nss_packages feed 提供并在构建时扫描，但不对外暴露该 feed 源
# CONFIG_FEED_nss_packages is not set
# 硬件简易 QoS 依赖 sqm-scripts-nss（来自 sqm_scripts_nss feed）
CONFIG_FEED_sqm_scripts_nss=y
# CONFIG_FEED_video is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ==============================================================================
# 一、完全不带 WiFi（P0）
#   DEVICE_PACKAGES := ipq-wifi-zn_m2 是设备默认包，必须在此显式覆盖为 n。
# ==============================================================================
CONFIG_PACKAGE_ipq-wifi-zn_m2=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpa-supplicant-mbedtls=n
CONFIG_PACKAGE_wpa-supplicant-openssl=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=n
CONFIG_PACKAGE_luci-app-wifischedule=n

# ==============================================================================
# 二、系统 / WebUI / 终端
# ==============================================================================
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufreq=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_autocore=y

# 内存压缩交换
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# 存储 / 硬件
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ttyd 内常用命令行工具
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_block-mount=y

# 性能 / 稳定（BBR 拥塞控制，配合 files/etc/sysctl.d/99-znm2.conf）
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ==============================================================================
# 三、网络基础（齐全但不冗余）
# ==============================================================================
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y
CONFIG_PACKAGE_pppoe-discovery=y
CONFIG_PACKAGE_luci-proto-ppp=y

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# FullCone NAT（nftables）
CONFIG_PACKAGE_kmod-nft-fullcone=y

# UPnP / NAT-PMP（nftables 变体，与 firewall4 一致）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# WireGuard（NSS 不加速 WG 流量，走 CPU，属预期）
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# IPTV 组播代理（体积小）
CONFIG_PACKAGE_omcproxy=y

# ==============================================================================
# 四、满血 NSS（仅有线，不含任何 WiFi offload）
#   注：包名以 nss_packages feed 实际定义为准
#       （clmapmgr 而非 clmapd；nss-ifb 的包名是 kmod-nss-ifb）
#   注意：NSS_DRV_*_ENABLE 这些 bool 在 nss_packages/qca-nss-drv/Config.in 中
#        默认全部为 n，必须显式打开，否则 kmod-qca-nss-ecm 等子模块会因依赖不满足
#        被 make defconfig 丢弃。
# ==============================================================================
CONFIG_NSS_MEM_PROFILE_MEDIUM=y
CONFIG_NSS_DRV_BRIDGE_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
CONFIG_NSS_DRV_PPPOE_ENABLE=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_LAG_ENABLE=y
CONFIG_NSS_DRV_TUN6RD_ENABLE=y
CONFIG_NSS_DRV_GRE_ENABLE=y
CONFIG_NSS_DRV_L2TP_ENABLE=y
CONFIG_NSS_DRV_MAPT_ENABLE=y
CONFIG_NSS_DRV_CLMAP_ENABLE=y
CONFIG_NSS_DRV_TUNIPIP6_ENABLE=y
# 硬件简易 QoS 所需（nsstbl / nssfq_codel / act_nssmirred）
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y

CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
# nss-drv-match 依赖 NSS_DRV_WIFIOFFLOAD_ENABLE（WiFi offload 分类器），
# 无 WiFi 固件不能开启 WiFi offload，因此不选该包。
CONFIG_PACKAGE_kmod-qca-nss-drv-match=n
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-clmapmgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-nss-ifb=y

# ==============================================================================
# 五、USB 完整功能（硬改 USB3.0）
# ==============================================================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_usbutils=y

# USB 网卡
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# USB 串口
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y

# ==============================================================================
# 六、应用插件（去重后）
# ==============================================================================
# KMS
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y

# SmartDNS（原 General.config 为 n，此处改为 y）
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y

# lucky 万吉 3.5.0（二进制由 scripts/Roc-script.sh 替换为 wanji 版）
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

# EasyTier（预编译二进制，noweb 变体控体积）
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier-noweb=y

# 流量统计（NSS 加速会漏统计，仅作近似账本）
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y

# 文件共享
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# ==============================================================================
# 七、QoS：三态互斥（off / 硬件简易 NSS / 软件 qosify）
#   切换逻辑见 packages/qos-switch（qos-switch + LuCI 页面 qosmode）
# ==============================================================================
# 软件 QoS（qosify：eBPF + CAKE，需停 ECM）
CONFIG_PACKAGE_qosify=y
# 硬件简易 QoS（nss-ifb + nsstbl/nssfq_codel；SQM 侧提供 nss-zk.qos 脚本）
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
# tc / 内核调度依赖
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_libbpf=y

# ==============================================================================
# 八、全简体中文：每个 luci-app 配套对应的 zh-cn 语言包
# ==============================================================================
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# 以下三个语言包由第三方仓库的 po/zh_Hans 自动生成
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

# ==============================================================================
# 九、主题：aurora（不再使用 argon）
# ==============================================================================
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

# ==============================================================================
# 十、明确排除（与 lucky 万吉功能重复 / 计划外 / 代理类 / 与 NSS 冲突）
#   本节只写 =n，且仅包含 feeds 中确实存在的符号，避免无意义符号被丢弃。
# ==============================================================================
# 代理 / 科学上网
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-openclash=n
# 与 lucky（DDNS/ACME/WOL/反代/FTP/WebDAV/FileBrowser/Rclone）重复
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_frp=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
# 计划外 / 不必要
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_nginx=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_btop=n
