### 通用配置文件（ZN-M2 主路由精简版 / 25.12 / apk）###
### 合并规则：本文件在设备 config 之后 cat，同名项以本文件为准 ###

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# 25.12 包管理器为 apk，与 Build-OpenWrt.yml 的 package_extension 一致
CONFIG_USE_APK=y

# 简体中文（替换原来的 zh_Hant）
CONFIG_LUCI_LANG_zh_Hans=y

# feed 开关：只决定设备上 apk 仓库清单是否列出该 feed（scripts/feeds feed_config 生成），
# nss_packages / sqm_scripts_nss 两个 feed 默认不启用，打开后刷机后仍可 apk 补装 NSS/SQM 包
CONFIG_FEED_nss_packages=y
CONFIG_FEED_sqm_scripts_nss=y
# CONFIG_FEED_video is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# 512M 内存下关闭 zram，把内存留给 NSS/Q6
CONFIG_PACKAGE_zram-swap=n

### 常用命令行（ttyd 里直接用）###
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_nstat=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_openssh-sftp-server=y

### 主题：只用 aurora，不装 argon ###
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-argon-config=n

### WebUI 组件 + 中文语言包 ###
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

### 网络基础：PPPoE / DHCPv6 / NAT6 / 防火墙 由 DEFAULT_PACKAGES.router 默认提供，这里只补 LuCI 协议界面 ###
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_kmod-pppoe=y

### USB（完整）+ 存储 ###
# kmod-usb3/kmod-usb-dwc3/kmod-usb-dwc3-qcom 已在 target DEFAULT_PACKAGES 内，显式声明防上游变动
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

### NSS（满血，去 WiFi 部分）###
# drv/ecm/dp/nss-ifb/qdisc/pppoe/bridge-mgr/vlan-mgr/igs/match/mirror/netlink/lag-mgr 已在 DEFAULT_PACKAGES 内
CONFIG_PACKAGE_kmod-qca-nss-drv-profile=y
# 以下为默认包内的无用 NSS 客户端模块，逐个关掉减体积
CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr=n
CONFIG_PACKAGE_kmod-qca-nss-drv-gre=n
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=n
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=n
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=n
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=n
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=n
CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr=n
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=n

### QoS：NSS 硬件整形 + 软件整形共存，LuCI 里切换脚本即可 ###
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

### 流量统计（不用 luci-app-statistics）###
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

### 必装：KMS ###
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

### 必装：WireGuard ###
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

### 必装：SmartDNS ###
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y

### 必装：Lucky（第三方源，Roc-script.sh 已内置克隆）###
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

### 必装：EasyTier（官方源 EasyTier/luci-app-easytier，见 Roc-script.sh 新增块）###
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y

### 必装：ttyd ###
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

### UPnP / WoL ###
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

### 明确不装：零科学上网 ###
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-openclash=n

### 明确不装：P2 默认删除 / 去重 / 精简 ###
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-watchcat=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-eqos=n
