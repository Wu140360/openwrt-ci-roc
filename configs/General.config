### 兆能M2 通用配置 - 精简高性能家庭主路由 ###

### ===== 编译选项 =====
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

### ===== 默认设置 (设备名/主机名等) =====
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

### ===== 系统语言: 简体中文 + 繁体中文 =====
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y

### ===== 主题: Aurora (唯一主题, 精简) =====
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

### ===== WebUI 基础 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_luci-app-uhttpd=y

### ===== TTYD 终端 (集成常用工具) =====
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

### ===== 包管理 (25.12 使用 apk) =====
### apk 包管理器在 25.12 中默认集成, 此处确保 WebUI 可用
CONFIG_PACKAGE_luci-app-opkg=y

### ===== DDNS (动态域名) =====
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts=y

### ===== WireGuard VPN =====
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

### ===== SmartDNS (解决GitHub DNS污染) =====
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y

### ===== NSS 硬件QoS (qosify + nss-qdisc) =====
### qosify 是 OpenWrt 官方推荐的 QoS 方案, 基于 nss-qdisc 实现硬件加速
CONFIG_PACKAGE_qosify=y
CONFIG_PACKAGE_luci-app-qosify=y
CONFIG_PACKAGE_kmod-qca-nss-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

### ===== KMS 激活服务 =====
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y

### ===== 网络基础功能 =====
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-autoreboot=y

### ===== CPU 频率调节 (性能优化, 降低发热) =====
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_cpufrequtils=y

### ===== 网络加速 TurboACC (NSS 快速转发) =====
CONFIG_PACKAGE_luci-app-turboacc=y

### ===== 系统监控与调试工具 =====
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_zoneinfo-asia=y

### ===== 配置与调试工具 (TTYD终端内常用) =====
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_traceroute6=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_bind-host=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=n

### ===== ZRAM 交换 (1GB内存优化) =====
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### ===== 显式禁用 (确保不残留) =====
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-vssr=n
CONFIG_PACKAGE_luci-app-bypass=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_ariang=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_frpc=n
CONFIG_PACKAGE_frps=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_lucky=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_openlist2=n
CONFIG_PACKAGE_luci-app-gecoosac=n
CONFIG_PACKAGE_gecoosac=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_samba4=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-oled=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-docker=n
CONFIG_PACKAGE_luci-app-unbound=n
CONFIG_PACKAGE_unbound=y
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_acme-acmesh-dnsapi=n
CONFIG_PACKAGE_luci-app-nginx=n
CONFIG_PACKAGE_nginx=n
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_openvpn=n
CONFIG_PACKAGE_luci-app-softethervpn=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_zerotier=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_transmission=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_qbittorrent=n
CONFIG_PACKAGE_luci-app-minidlna=n
CONFIG_PACKAGE_minidlna=n
CONFIG_PACKAGE_luci-app-nfs=n
CONFIG_PACKAGE_nfs-kernel-server=n
CONFIG_PACKAGE_luci-app-vnstat=n
CONFIG_PACKAGE_vnstat=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_nlbwmon=n
CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_adblock=n
CONFIG_PACKAGE_luci-app-privoxy=n
CONFIG_PACKAGE_privoxy=n
CONFIG_PACKAGE_luci-app-haproxy-tcp=n
CONFIG_PACKAGE_haproxy=n
CONFIG_PACKAGE_luci-app-mwan3=n
CONFIG_PACKAGE_mwan3=n

### ===== SQM-NSS 脚本 (注意: 不使用 sqm-scripts-nss, 改用 qosify) =====
CONFIG_PACKAGE_sqm-scripts-nss=n

### ===== PassWall 完全禁用 =====
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
