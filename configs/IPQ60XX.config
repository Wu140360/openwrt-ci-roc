# ==============================================================================
# 兆能 M2（ZN-M2 / Qualcomm IPQ6000）—— 本仓库唯一构建目标
# 源码：LibWrt 25.12-nss（OpenWrt 25.12 稳定版 + 满血 NSS，内核 6.12）
# 产物：openwrt-qualcommax-ipq60xx-zn_m2-squashfs-factory.ubi
#       openwrt-qualcommax-ipq60xx-zn_m2-squashfs-sysupgrade.bin
# 说明：本文件先被写入 .config，随后追加 configs/General.config（后者覆盖前者）。
# ==============================================================================

# ---------------------------- 目标与机型 ----------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y

# 单机型构建（不使用 MULTI_PROFILE / 按设备独立 rootfs）：
# 选中 Target Profile 选项本身，确保镜像构建时只命中 DEVICE_zn_m2。
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y
# 兼容保留：MULTI_PROFILE 关闭后该符号不生效，仅用于标记设备身份。
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_PROFILE="DEVICE_zn_m2"

# ---------------------------- 满血 NSS（仅有线） ----------------------------
# NSS 固件固定 11.4（IPQ60xx 有线加速验证版本）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
