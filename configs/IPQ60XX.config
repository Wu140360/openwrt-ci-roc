CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y

# 仅保留兆能 ZN M2，其余机型一律不编译（仓库里其他机型的支持全部不要）
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2=""

# 满血 NSS：沿用仓库 IPQ60XX.config 的默认推荐值
# q6_region 改为 16MB 由 scripts/Roc-script.sh 完成（无 WiFi 场景）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_MEM_PROFILE_512M=y

# 完全不要 WiFi：参照仓库 configs/JDCloud.NoWiFi.config 的写法
# 额外排除 M2 的板级 WiFi 校准数据（原由 image/ipq60xx.mk 的 DEVICE_PACKAGES 注入）
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ipq-wifi-zn_m2=n

# 排除 NSS 中 WiFi 专属的 offload，只保留有线侧满血 NSS
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
