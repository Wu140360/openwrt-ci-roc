#!/bin/sh
# NSS hardware QoS control (multi-interface rules).
# For every enabled rule: nsstbl + nssprio + nssfq_codel on the selected
# nss-dp interface (egress) and, optionally, ifb + act_nssmirred for ingress.
# ECM hardware offload stays enabled; no software QoS is involved.

CONFIG=nssqos

. /lib/functions.sh
STATE=/var/run/nssqos.state
TC=/sbin/tc
IP=/sbin/ip
APPLY_FAILED=0

log() { logger -t nss-qos "$*" 2>/dev/null || true; }

fail() {
	echo "错误: $*" >&2
	log "error: $*"
	exit 1
}

is_uint() {
	case "$1" in
	'' | *[!0-9]*) return 1 ;;
	*) return 0 ;;
	esac
}

ifb_for() { printf 'nssq-%s\n' "$1"; }

list_nss_ifaces() {
	local d n driver

	for d in /sys/class/net/*; do
		n="${d##*/}"
		[ -e "$d/device" ] || continue
		driver="$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)" 2>/dev/null)"
		[ "$driver" = "nss-dp" ] && printf '%s\n' "$n"
	done | sort
}

dev_mtu() {
	local mtu

	mtu="$($IP link show dev "$1" 2>/dev/null |
		awk '{for (i = 1; i <= NF; i++) if ($i == "mtu") {print $(i + 1); exit}}')"
	[ -n "$mtu" ] || mtu=1500
	printf '%s\n' "$mtu"
}

burst_of() {
	local speed="$1" mtu="$2" burst

	burst=$((speed / 8))
	[ "$burst" -ge "$mtu" ] || burst="$mtu"
	burst=$((burst / mtu * mtu))
	[ "$burst" -ge "$mtu" ] || burst="$mtu"
	# nsstbl child qdiscs default to a 1514 byte MTU, keep bursts above it
	[ "$burst" -ge 1518 ] || burst=1518
	printf '%s\n' "$burst"
}

limit_of() {
	local speed="$1" mtu="$2" limit

	limit=$((speed * 125 / 10 / mtu))
	[ "$limit" -ge 200 ] || limit=200
	printf '%s\n' "$limit"
}

quantum_of() {
	local speed="$1" mtu="$2" quantum

	quantum="$mtu"
	if [ "$speed" -lt 100000 ]; then
		quantum=$((mtu / 5))
		[ "$quantum" -ge 300 ] || quantum=300
	fi
	printf '%s\n' "$quantum"
}

load_modules() {
	local module

	for module in qca_nss_qdisc act_nssmirred ifb; do
		[ -d "/sys/module/$module" ] || modprobe "$module" 2>/dev/null ||
			fail "无法加载内核模块 $module"
	done
}

cleanup_dev() {
	local dev="$1" parent

	[ -d "/sys/class/net/$dev" ] || return 0
	$TC qdisc list dev "$dev" 2>/dev/null |
		awk '$1 == "qdisc" && $4 == "parent" {print $5}' |
		sort -t: -k1nr,2nr |
		while read -r parent; do
			[ -n "$parent" ] || continue
			$TC qdisc del dev "$dev" parent "$parent" 2>/dev/null
		done
	$TC qdisc del dev "$dev" root 2>/dev/null
	return 0
}

cleanup_iface() {
	local iface="$1" ifb

	ifb="$(ifb_for "$iface")"
	cleanup_dev "$iface"
	$TC qdisc del dev "$iface" ingress 2>/dev/null
	if [ -d "/sys/class/net/$ifb" ]; then
		cleanup_dev "$ifb"
		$IP link set dev "$ifb" down 2>/dev/null
		$IP link del dev "$ifb" 2>/dev/null
	fi
	return 0
}

cleanup_state() {
	local iface ifb

	[ -f "$STATE" ] || return 0
	while IFS="$(printf '\t')" read -r iface ifb; do
		[ -n "$iface" ] || continue
		[ -n "$ifb" ] || ifb="$(ifb_for "$iface")"
		cleanup_iface "$iface" "$ifb"
	done <"$STATE"
	rm -f "$STATE"
	return 0
}

build_tree() {
	local dev="$1" speed="$2" mtu="$3" target="$4"
	local burst burst10 burst40 speed10 speed40 limit quantum

	[ -n "$target" ] || target=5ms
	burst="$(burst_of "$speed" "$mtu")"
	speed10=$((speed / 10))
	[ "$speed10" -ge 1 ] || speed10=1
	speed40=$((speed * 4 / 10))
	[ "$speed40" -ge 1 ] || speed40=1
	burst10="$(burst_of "$speed10" "$mtu")"
	burst40="$(burst_of "$speed40" "$mtu")"
	limit="$(limit_of "$speed" "$mtu")"
	quantum="$(quantum_of "$speed" "$mtu")"

	$TC qdisc add dev "$dev" root handle 1: nsstbl rate "${speed}kbit" burst "$burst" mtu "$mtu" accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 1: handle 10: nssprio bands 3 accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 10:1 handle 100: nsstbl rate "${speed10}kbit" burst "$burst10" accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 100: handle 1000: nsspfifo limit 100 accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 10:2 handle 200: nsstbl rate "${speed40}kbit" burst "$burst40" accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 200: handle 2000: nssred limit 100k min 30k max 80k avpkt 1k burst 55 probability 0.50 accel_mode 0 || return 1
	$TC qdisc add dev "$dev" parent 10:3 handle 300: nssfq_codel limit "$limit" target "$target" interval 100ms flows 1024 quantum "$quantum" set_default accel_mode 0 || return 1
}

apply_rule() {
	local sec="$1" enabled iface egress ingress mtu ifb driver target

	enabled="$(uci -q get "$CONFIG.$sec.enabled")"
	[ "$enabled" = 1 ] || return 0
	iface="$(uci -q get "$CONFIG.$sec.iface")"
	[ -n "$iface" ] || return 0
	if [ ! -d "/sys/class/net/$iface" ]; then
		log "skip missing interface $iface"
		return 0
	fi
	driver="$(basename "$(readlink -f "/sys/class/net/$iface/device/driver" 2>/dev/null)" 2>/dev/null)"
	if [ "$driver" != "nss-dp" ]; then
		log "skip non nss-dp interface $iface"
		return 0
	fi

	egress="$(uci -q get "$CONFIG.$sec.egress")"
	ingress="$(uci -q get "$CONFIG.$sec.ingress")"
	is_uint "$egress" || egress=0
	is_uint "$ingress" || ingress=0
	[ "$egress" -gt 0 ] || [ "$ingress" -gt 0 ] || return 0

	target="$(uci -q get "$CONFIG.$sec.target")"
	[ -n "$target" ] || target=5ms
	mtu="$(dev_mtu "$iface")"
	mtu=$((mtu + 18))
	ifb="$(ifb_for "$iface")"
	cleanup_iface "$iface"

	if [ "$egress" -gt 0 ]; then
		build_tree "$iface" "$egress" "$mtu" "$target" || {
			cleanup_iface "$iface"
			log "egress shaping failed on $iface"
			APPLY_FAILED=1
			return 0
		}
	fi

	if [ "$ingress" -gt 0 ]; then
		$IP link add name "$ifb" type ifb 2>/dev/null || true
		$IP link set dev "$ifb" up 2>/dev/null || {
			cleanup_iface "$iface"
			log "cannot create $ifb"
			APPLY_FAILED=1
			return 0
		}
		$TC qdisc add dev "$iface" handle ffff: ingress 2>/dev/null || true
		$TC filter add dev "$iface" parent ffff: protocol all u32 match u32 0 0 \
			action nssmirred redirect dev "$ifb" fromdev "$iface" || {
			cleanup_iface "$iface"
			log "nssmirred failed on $iface"
			APPLY_FAILED=1
			return 0
		}
		build_tree "$ifb" "$ingress" "$mtu" "$target" || {
			cleanup_iface "$iface"
			log "ingress shaping failed on $iface"
			APPLY_FAILED=1
			return 0
		}
	fi

	printf '%s\t%s\n' "$iface" "$ifb" >>"$STATE"
	return 0
}

apply_qos() {
	load_modules
	cleanup_state
	: >"$STATE"
	APPLY_FAILED=0
	config_load "$CONFIG"
	config_foreach apply_rule rule
	if [ "$APPLY_FAILED" != 0 ]; then
		cleanup_state
		fail "部分规则应用失败，已回滚"
	fi
	log "applied rules from $CONFIG"
}

show_rule() {
	local sec="$1" enabled iface egress ingress ifb

	enabled="$(uci -q get "$CONFIG.$sec.enabled")"
	iface="$(uci -q get "$CONFIG.$sec.iface")"
	egress="$(uci -q get "$CONFIG.$sec.egress")"
	ingress="$(uci -q get "$CONFIG.$sec.ingress")"
	printf '\n--- %s (启用=%s 出=%s kbps 入=%s kbps) ---\n' \
		"$iface" "${enabled:-0}" "${egress:-0}" "${ingress:-0}"
	[ -d "/sys/class/net/$iface" ] || {
		echo "接口不存在"
		return 0
	}
	$TC -s qdisc show dev "$iface" 2>/dev/null | head -24
	ifb="$(ifb_for "$iface")"
	if [ -d "/sys/class/net/$ifb" ]; then
		printf -- '--- 入方向 (%s) ---\n' "$ifb"
		$TC -s qdisc show dev "$ifb" 2>/dev/null | head -24
	fi
}

show_status() {
	printf '=== NSS 接口 ===\n'
	list_nss_ifaces | tr '\n' ' '
	printf '\n'
	if [ -f "$STATE" ]; then
		printf '=== 已应用 ===\n'
		cat "$STATE"
	fi
	config_load "$CONFIG"
	config_foreach show_rule rule
}

stop_all() {
	cleanup_state
	log "stopped"
}

case "${1:-}" in
list) list_nss_ifaces ;;
apply | start) apply_qos ;;
stop) stop_all ;;
restart | reload)
	stop_all
	apply_qos
	;;
status) show_status ;;
*)
	echo "用法: $0 {list|apply|stop|restart|status}" >&2
	exit 1
	;;
esac
